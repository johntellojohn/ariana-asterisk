# Plantilla minima clonable para despliegue en servidor LAN del cliente / Hospital (ariana-asterisk v2)
# Toda la configuracion de Issabel, EVA Cloud e IA se guarda cifrada en ./data desde /admin.
NODE_ENV=production
PORT=3002
# Si existe proxy SSL nginx escuchando en 366, mantener HOST_PORT=3002; si Node expone directo, usar 366.
HOST_PORT=3002
DATA_DIR=/app/data

# Llave maestra AES-256-GCM unica por servidor (minimo 32 caracteres). Si se deja vacia, se genera ./data/.master.key
CONFIG_MASTER_KEY=cambiar_por_llave_larga_unica_por_servidor_32_chars

# Credenciales iniciales de arranque para https://DOMINIO:366/admin (luego se cambia la clave dentro de /admin)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=cambiar_clave_inicial_segura

