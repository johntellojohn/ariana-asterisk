# Plantilla minima clonable para despliegue en servidor LAN del cliente / Hospital (ariana-asterisk v2)
# Toda la configuracion de Issabel, EVA Cloud e IA se guarda cifrada en ./data desde /admin.
NODE_ENV=production
PORT=3002
# Si existe proxy SSL nginx escuchando en 366, descomenta estas 2 lineas para que `docker compose up -d` levante nginx SSL + api sin editar docker-compose.yml:
# COMPOSE_FILE=docker-compose.yml:docker-compose.ssl.yml
# API_HOST_PORT=127.0.0.1:3002
HOST_PORT=366
DATA_DIR=/app/data

# Llave maestra AES-256-GCM unica por servidor (minimo 32 caracteres). Si se deja vacia, se genera ./data/.master.key
CONFIG_MASTER_KEY=cambiar_por_llave_larga_unica_por_servidor_32_chars

# Credenciales iniciales de arranque para https://DOMINIO:366/admin (luego se cambia la clave dentro de /admin)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=cambiar_clave_inicial_segura

# SIP Media Bridge opcional (Plan A navegador Chrome solo para Issabel 4 / Asterisk < 16.6).
# En Issabel 5 / Asterisk >= 16.6 (ari_media nativo) dejar COMPOSE_PROFILES comentado.
# COMPOSE_PROFILES=sip-bridge
# IP LAN de este servidor Ubuntu visible por Issabel (necesario para RTP SDP en Plan A sip_bridge sobre Asterisk 13.x)
SIP_BRIDGE_PUBLIC_IP=
SIP_BRIDGE_ARI_PASSWORD=ariana_bridge_local

