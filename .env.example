# ==============================================================================
# Ariana Asterisk Gateway v2 - Variables minimas de servidor / Docker
# ==============================================================================
# Toda la configuracion operativa (EVA Cloud, tenant, tokens, Issabel AMI/ARI,
# cola, modo de respuesta, grabaciones y OpenAI API Key) se configura desde la
# vista web https://TU_DOMINIO:366/admin y se guarda cifrada (AES-256-GCM) en
# ./data/config.enc.json. NO hace falta duplicarla aqui.

NODE_ENV=production

# Puerto interno del contenedor Node y puerto publico HTTPS/HTTP
PORT=3002
HOST_PORT=366

# SSL opcional en Docker (Nginx incluido en el repo).
# Para activar HTTPS: guarda fullchain.pem + key.pem en ./nginx/certs/ y descomenta estas 2 lineas:
# COMPOSE_FILE=docker-compose.yml:docker-compose.ssl.yml
# API_HOST_PORT=127.0.0.1:3002

# Carpeta persistente (config cifrada, auth /admin, outbox offline y Caja Negra)
DATA_DIR=/app/data

# Opcional: llave maestra (32+ chars) para cifrar ./data/config.enc.json.
# Si se deja vacia, el gateway genera automaticamente ./data/.master.key.
# IMPORTANTE: en un servidor ya instalado no cambies esta variable despues de crear ./data/config.enc.json.
CONFIG_MASTER_KEY=

# Credenciales iniciales para el primer ingreso a /admin (luego cambialas dentro del panel)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=cambiar_clave_inicial_segura

# SIP Media Bridge (Plan A navegador Chrome para Issabel / Asterisk < 16.6)
# IP LAN fija de este servidor Docker visible desde el Issabel del cliente
SIP_BRIDGE_PUBLIC_IP=
SIP_BRIDGE_ARI_PASSWORD=ariana_bridge_local

# Opcional: rango UDP RTP del gateway (por defecto docker-compose usa 46000-46200)
# ARI_EXTERNAL_MEDIA_PORT_START=46000
# ARI_EXTERNAL_MEDIA_PORT_END=46200
